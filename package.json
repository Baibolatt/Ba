{
  "name": "partshub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3012",
    "build": "next build",
    "start": "next start -p 3012",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "generate:samples": "tsx scripts/generate-sample-imports.ts",
    "test:import": "tsx scripts/test-import.ts",
    "test:search": "tsx scripts/test-search.ts",
    "test:assistant": "tsx scripts/test-assistant.ts",
    "test": "npm run test:import && npm run test:search && npm run test:assistant"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "iconv-lite": "^0.6.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
