// Схема БД PartsHub
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  shortName   String
  description String
  icon        String
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String        @id @default(cuid())
  article       String        @unique
  name          String
  brandId       String
  categoryId    String
  price         Int // цена в тенге, целое число
  oldPrice      Int? // старая цена в тенге
  quantity      Int           @default(0) // остаток на складе
  unit          String        @default("шт.")
  imageUrl      String? // фото; пока может быть null — используется заглушка
  description   String
  compatibility String        @default("") // совместимость с авто, текст
  badge         String? // Хит / Новинка
  sortOrder     Int           @default(0)
  brand         Brand         @relation(fields: [brandId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  specs         ProductSpec[]
  orderItems    OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// История импорта прайс-листов: последний завершённый импорт нужен,
// чтобы обнулять остатки у товаров, которых не было в файле.
model ImportRun {
  id           String   @id @default(cuid())
  fileName     String
  totalRows    Int
  createdCount Int      @default(0)
  updatedCount Int      @default(0)
  // JSON-массив нормализованных артикулов из файла.
  articleKeys  String   @default("[]")
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([completed, createdAt])
}

// Клиент магазина. Заказ может быть оформлен гостем (userId = null),
// поэтому удаление аккаунта не удаляет историю заказов.
model User {
  id           String   @id @default(cuid())
  // Вход по номеру телефона: хранится в каноническом виде +77001234567.
  phone        String   @unique
  // Необязательный email для связи; вход по нему не выполняется.
  email        String?  @unique
  passwordHash String
  name         String
  city         String   @default("")
  address      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Order {
  id             String      @id @default(cuid())
  userId         String?
  number         String      @unique
  customerName   String
  phone          String
  email          String? // email для связи, введённый при оформлении
  address        String? // адрес доставки; для самовывоза — пункт выдачи
  deliveryMethod String      @default("pickup") // pickup | courier
  comment        String?
  payment        String?
  status         String      @default("new") // new | in_progress | done
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int // цена на момент заказа, тенге
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
}
