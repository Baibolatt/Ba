DATABASE_URL="file:./prisma/dev.db"
# Пароль для входа в /admin. Задайте свой и не коммитьте .env.
ADMIN_PASSWORD="change-me"
# Ключ подписи сессий клиентов. Если не задан, используется ADMIN_PASSWORD.
SESSION_SECRET="change-me-too"
# Ключ DeepSeek для умного поиска и ИИ-консультанта. Без него работает обычный поиск.
DEEPSEEK_API_KEY=
